[NAME]
name=rpmcreator

[VERSION]
version=2.8

[RELEASE]
release=0.mrx10

[GROUP]
group=Applications/System

[DESCRIPTION]
0=GUI for building RPM and DEB packages from pre-installed files and folders
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2021

[SUMMARY]
summary=GUI for building RPM and DEB packages

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/RPMCreator

[LICENSE]
license=GPLv3

[DEPS]
deps=xterm rpm-build dpkg-dev gtk2

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/rpmcreator
1=/usr/share/icons/rpmcreator.png
2=/usr/share/mime/packages/rpmcreator.xml
3=/usr/share/applications/rpmcreator.desktop
4=/usr/share/icons/hicolor/scalable/mimetypes/application-x-rpmcreator-project.svg
5=/usr/share/RPMCreator/
6=/usr/share/doc/rpmcreator/

[AFTERINSTALL]
0=#!/bin/bash
1=export PKGSYSTEM_ENABLE_FSYNC=0 && update-mime-database -n /usr/share/mime
2=update-desktop-database -q /usr/share/applications
3=gtk-update-icon-cache -q -f /usr/share/icons/hicolor

[AFTERREMOVE]
0=#!/bin/bash
1=export PKGSYSTEM_ENABLE_FSYNC=0 && update-mime-database -n /usr/share/mime
2=update-desktop-database -q /usr/share/applications
3=gtk-update-icon-cache -q -f /usr/share/icons/hicolor

[URL32]
url32=https://github.com/AKotov-dev/RPMCreator

[PROGRAMNAME]
programname=RPMCreator

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=v2.8
1=+ Build in Lazarus-4.4
2=+ Removing dependency on p7zip
3=+ Automatic script creation ~/.RPMCreator/unpack.sh
4=+ Full RPM and DEB unpacking via rpm2cpio and dpkg-deb
5=+ RPM packages for Mageia-10
6=
7=**Note:** Full unpacking now allows you to control RPM scripts, info, changelog, filelist, requires, provides, triggers and DEB conffiles, control, md5sums, postinst, postrm, preinst, prerm.
